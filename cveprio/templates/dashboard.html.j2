<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<title>CVE Priorities{% if run.mode == "offline_demo" %} (DEMO){% endif %}</title>
<style>
:root {
  color-scheme: light;
  --bg: #f6f6f4; --surface: #fcfcfb; --surface-2: #f0efec; --border: #dedcd6;
  --text: #0b0b0b; --text-2: #52514e; --muted: #77756f; --link: #1f63b5;
  --critical: #d03b3b; --serious: #ec835a; --warning: #fab219; --good: #0ca30c;
  --critical-ink: #a32424; --serious-ink: #9a4318; --warning-ink: #7a5300; --good-ink: #006300;
  --badge-neutral: #e6e4df; --demo-bg: #fff4d6; --demo-border: #fab219; --ai-bg: #eef3fb; --ai-border: #8fb1e0;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --bg: #121211; --surface: #1a1a19; --surface-2: #232321; --border: #3a3936;
    --text: #ffffff; --text-2: #c3c2b7; --muted: #9a998f; --link: #7fb0f0;
    --critical-ink: #ff8a80; --serious-ink: #f5a582; --warning-ink: #fcd06a; --good-ink: #6fd96f;
    --badge-neutral: #34332f; --demo-bg: #3a2f10; --ai-bg: #17233a; --ai-border: #3f6aa8;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #121211; --surface: #1a1a19; --surface-2: #232321; --border: #3a3936;
  --text: #ffffff; --text-2: #c3c2b7; --muted: #9a998f; --link: #7fb0f0;
  --critical-ink: #ff8a80; --serious-ink: #f5a582; --warning-ink: #fcd06a; --good-ink: #6fd96f;
  --badge-neutral: #34332f; --demo-bg: #3a2f10; --ai-bg: #17233a; --ai-border: #3f6aa8;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1200px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 24px; margin: 0 0 4px; }
h2 { font-size: 18px; margin: 32px 0 12px; }
h3 { font-size: 15px; margin: 20px 0 6px; }
a { color: var(--link); overflow-wrap: anywhere; }
.meta { color: var(--text-2); font-size: 13px; }
.banner { border: 2px solid var(--demo-border); background: var(--demo-bg); border-radius: 8px; padding: 10px 14px; margin: 16px 0; font-weight: 600; }
.banner small { display: block; font-weight: 400; color: var(--text-2); }
.notices { color: var(--text-2); font-size: 13px; margin: 8px 0 0; padding-left: 18px; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 20px; }
.tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; cursor: pointer; text-align: left; color: var(--text); font: inherit; }
.tile[aria-pressed="true"] { outline: 2px solid var(--link); }
.tile .label { font-size: 13px; color: var(--text-2); display: flex; gap: 6px; align-items: center; }
.tile .value { font-size: 28px; font-weight: 600; }
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: none; }
.s-critical { --c: var(--critical); --ci: var(--critical-ink); }
.s-serious { --c: var(--serious); --ci: var(--serious-ink); }
.s-warning { --c: var(--warning); --ci: var(--warning-ink); }
.s-good { --c: var(--good); --ci: var(--good-ink); }
.s-neutral { --c: var(--text-2); --ci: var(--text); }
.s-muted { --c: var(--muted); --ci: var(--text-2); }
.dot { background: var(--c); }
.badge { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 2px 10px; font-size: 13px; font-weight: 600; background: var(--badge-neutral); color: var(--ci); white-space: nowrap; border-left: 4px solid var(--c); }
.compare { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; }
.compare li { margin: 2px 0; }
.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 24px 0 8px; }
.controls input { flex: 1 1 240px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; }
.controls button { padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; cursor: pointer; }
details.cve { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; margin: 10px 0; }
details.cve > summary { list-style: none; cursor: pointer; padding: 12px 16px; display: grid; grid-template-columns: 150px minmax(190px, max-content) 1fr; gap: 8px 16px; align-items: center; }
details.cve > summary::-webkit-details-marker { display: none; }
details.cve[open] > summary { border-bottom: 1px solid var(--border); }
.cveid { font-weight: 700; font-variant-numeric: tabular-nums; }
.headline { color: var(--text-2); }
.factors { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--text-2); }
.factors b { color: var(--text); font-weight: 600; }
.body { padding: 4px 16px 16px; }
.cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 28px; }
.cols > div, details.cve > summary > * { min-width: 0; }
li, td, .desc, .headline { overflow-wrap: anywhere; }
ul.tight { margin: 4px 0; padding-left: 20px; }
ul.tight li { margin: 3px 0; }
.cite { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.desc { background: var(--surface-2); border-radius: 8px; padding: 8px 12px; font-size: 14px; color: var(--text-2); }
.desc b { color: var(--text); }
.ai { background: var(--ai-bg); border: 1px solid var(--ai-border); border-radius: 8px; padding: 10px 14px; margin-top: 16px; }
.ai .tag { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--link); }
.scripted { border: 2px dashed var(--demo-border); background: var(--demo-bg); padding: 6px 10px; border-radius: 6px; font-weight: 600; margin: 6px 0; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th, td { text-align: left; vertical-align: top; padding: 6px 8px; border-bottom: 1px solid var(--border); }
th { color: var(--text-2); font-weight: 600; }
td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.flag { color: var(--warning-ink); font-weight: 600; }
.st-affected { color: var(--critical-ink); font-weight: 600; }
.st-needs_review { color: var(--warning-ink); font-weight: 600; }
.st-not_affected { color: var(--good-ink); font-weight: 600; }
table.wide { min-width: 680px; }
table.wide td { overflow-wrap: break-word; }
.summary-box { border: 1px solid var(--border); border-left: 6px solid var(--c); background: var(--surface-2); border-radius: 10px; padding: 14px 18px; margin: 14px 0 6px; }
.sum-label { font-size: 20px; font-weight: 700; color: var(--ci); }
.sum-label .prov { font-size: 13px; font-weight: 500; color: var(--text-2); }
.sum-why { font-size: 16px; margin: 6px 0 10px; }
.summary-box h4 { margin: 10px 0 4px; font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-2); }
.fgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin: 12px 0; }
.fcard { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; background: var(--surface); }
.fname { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-2); }
.fval { font-size: 15px; font-weight: 600; margin-top: 2px; }
.sec { border-top: 1px solid var(--border); padding-top: 6px; margin-top: 18px; }
.sec h3 { font-size: 17px; margin: 8px 0 2px; display: flex; align-items: center; gap: 8px; }
.ico { display: inline-flex; width: 24px; height: 24px; border-radius: 50%; align-items: center; justify-content: center; font-size: 14px; background: var(--badge-neutral); }
.sec-known .ico { color: var(--good-ink); } .sec-unc .ico { color: var(--warning-ink); } .sec-why .ico, .sec-change .ico { color: var(--link); }
.hint { margin: 0 0 6px; color: var(--text-2); font-size: 13px; }
ul.items, ol.items { margin: 4px 0; padding-left: 22px; line-height: 1.6; }
ul.items li, ol.items li { margin: 8px 0; }
.chips { display: inline-flex; flex-wrap: wrap; gap: 4px; vertical-align: 1px; }
.chip { font-size: 11px; line-height: 1.6; padding: 0 7px; border-radius: 999px; background: var(--badge-neutral); color: var(--text-2); text-decoration: none; white-space: nowrap; font-variant-numeric: tabular-nums; }
a.chip:hover { color: var(--link); }
.desc-box { margin-top: 18px; border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; background: var(--surface-2); }
.desc-box summary { cursor: pointer; }
.desc-box p { color: var(--text-2); margin: 8px 0 4px; }
.primary-row td { font-weight: 600; }
.fcode { font-size: 12px; color: var(--muted); margin-top: 4px; }
.fcode code, code.vec { font-size: 11.5px; }
code.vec { overflow-wrap: anywhere; color: var(--text-2); }
details.more-chips { display: inline; }
details.more-chips > summary { display: inline; list-style: none; cursor: pointer; }
details.more-chips > summary::-webkit-details-marker { display: none; }
details.more-chips[open] > summary { display: none; }
details.more-chips a.chip { margin-right: 4px; }
.bshort { font-weight: 500; }
details.bmore { display: inline; margin-left: 6px; }
details.bmore > summary { display: inline; list-style: none; cursor: pointer; font-size: 12px; color: var(--link); white-space: nowrap; }
details.bmore > summary::-webkit-details-marker { display: none; }
details.bmore > summary::before { content: "▸ "; }
details.bmore[open] > summary::before { content: "▾ "; }
.bdetail { display: block; margin: 4px 0 2px; padding: 6px 10px; border-left: 3px solid var(--border); background: var(--surface-2); border-radius: 0 6px 6px 0; font-size: 13.5px; color: var(--text-2); line-height: 1.5; }
.srcs { display: block; margin-top: 4px; font-size: 12px; color: var(--muted); }
.tech table, .tech tbody, .tech tr, .tech th, .tech td { display: block; width: auto; }
.tech tr { padding: 6px 0; border-bottom: 1px solid var(--border); }
.tech th, .tech td { border: 0; padding: 2px 0; }
.tech th { color: var(--text-2); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.tech td { overflow-wrap: break-word; }
@keyframes flash { from { box-shadow: 0 0 0 3px var(--link); } to { box-shadow: 0 0 0 3px transparent; } }
.flash { animation: flash 2s ease-out; }
details.cve { scroll-margin-top: 12px; }
.vtitle { grid-column: 1 / -1; font-size: 13px; color: var(--text-2); font-style: italic; margin-top: -4px; }
tr:target td { background: var(--demo-bg); }
.intro { margin: 16px 0 0; color: var(--text-2); }
.empty { padding: 20px; border: 1px dashed var(--border); border-radius: 10px; color: var(--text-2); }
footer { margin-top: 40px; color: var(--text-2); font-size: 13px; }
.hidden { display: none !important; }
:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: 4px; }
.headrow { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
.theme { font: inherit; font-size: 13px; padding: 4px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); cursor: pointer; }
.sources-line { margin: 10px 0 0; font-size: 13px; color: var(--text-2); }
.sources-line.bad { color: var(--warning-ink); font-weight: 600; }
.legend { margin: 10px 0 0; padding-left: 18px; color: var(--text-2); font-size: 13px; }
@media (max-width: 760px) {
  details.cve > summary { grid-template-columns: 1fr; }
  .cols { grid-template-columns: minmax(0, 1fr); }
}
</style>
</head>
<body>
<main>
<header>
  <div class="headrow">
  <h1>CVE prioritization{% if run.organization %} · {{ run.organization }}{% endif %}</h1>
  <button id="theme" class="theme" type="button" aria-label="Colour theme: automatic">Theme: auto</button>
  </div>
  <div class="meta">Generated {{ run.generated_at.strftime("%Y-%m-%d %H:%M UTC") }} · <b>{{ "offline demo data" if run.mode == "offline_demo" else "live data" }}</b> · {{ run.reports|length }} CVEs · cveprio {{ run.tool_version }}</div>
  {% if run.mode == "offline_demo" %}
  <div class="banner" role="note">⚠ OFFLINE DEMO DATA — recorded fixtures, not live results.
    <small>Source responses were recorded at the retrieval times shown in each evidence table and may be out of date.{% if run.fictional_context %} The inventory and business context are fictional.{% endif %}</small></div>
  {% elif run.fictional_context %}
  <div class="banner" role="note">⚠ Inventory and business context are FICTIONAL example data.</div>
  {% endif %}
</header>

<p class="intro">Each card below is one vulnerability (CVE), most urgent first. Click a card to see why it got its priority and what to do; click “▸ details” on any line for the full explanation and its sources. Click a tile to show only that group.</p>
<ul class="legend">
  <li><b>Priority</b> (P1–P4) is the decision: how soon to act. It combines the three things below using fixed rules.</li>
  <li><b>Attack activity</b>: evidence that attackers use the flaw. <b>Severity</b>: the technical score (CVSS, 0–10) on paper. <b>Exposure</b>: whether <i>your</i> systems are affected, reachable and important.</li>
  <li><b>Provisional</b> means the decision depends on information that was not supplied. <b>Needs review</b> means a person must check before deciding.</li>
</ul>
<section aria-label="Summary">
  <div class="tiles">
  {% for key, label, n in tiles %}
    {% set st = status.get(key, ("muted", "–")) %}
    <button class="tile s-{{ st[0] }}" data-filter="{{ key }}" aria-pressed="false">
      <span class="label"><span class="dot" aria-hidden="true"></span>{% if key in ("P1", "P2", "P3", "P4") %}{{ key }} · {% endif %}{{ label }}</span>
      <span class="value">{{ n }}</span>
    </button>
  {% endfor %}
  </div>
  {% if src.bad %}
  <p class="sources-line bad" role="status">⚠ {{ src.bad|length }} of {{ src.total }} source lookups failed or were rate-limited, so some results are partial: {% for cid, name, st in src.bad %}<a href="#{{ cid }}">{{ cid }}</a> ({{ name }}: {{ st }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
  {% else %}
  <p class="sources-line">All {{ src.total }} source lookups returned an answer{% if run.mode == "offline_demo" %} (recorded data){% endif %}. "Not found" answers count as answers; each card lists its sources.</p>
  {% endif %}
</section>

{% if run.discovery %}
{% set disc = run.discovery %}
<h2>CVE discovery</h2>
<div class="compare">
  <p style="margin:0 0 6px"><b>{{ disc.total_found }}</b> candidate CVEs found from the inventory; <b>{{ disc.analyzed|length }}</b> analysed{% if disc.dropped %}; <span class="flag">{{ disc.dropped|length }} over the cap were NOT analysed</span>{% endif %}.</p>
  <div class="table-wrap"><table class="wide">
    <thead><tr><th>Asset</th><th>Software</th><th>Method</th><th>Status</th><th>CVEs</th><th>Notes</th></tr></thead>
    <tbody>
    {% for q in disc.queries %}
    <tr><td>{{ q.asset_id }}</td><td>{{ q.product }} {{ q.version }}</td><td>{{ {"nvd_cpe": "NVD (CPE match)", "osv_purl": "OSV (package URL)"}.get(q.method, q.method|replace("_", " ")) }}</td>
        <td class="{{ 'flag' if q.status != 'ok' else '' }}">{{ q.status|replace("_", " ") }}</td><td class="num">{{ q.cve_ids|length }}</td>
        <td>{{ q.detail or "" }}{% if q.non_cve_ids %} {{ q.non_cve_ids|length }} non-CVE advisories not analysed{% endif %}</td></tr>
    {% endfor %}
    </tbody></table></div>
  <ul class="tight meta">{% for c in disc.caveats %}<li>{{ c }}</li>{% endfor %}</ul>
</div>
{% endif %}

<h2>How this differs from sorting by severity score alone</h2>
<div class="compare">
  <p style="margin:0 0 8px">A common shortcut is to fix vulnerabilities in order of their severity score (CVSS). This tool also looks at whether attackers are using the flaw and whether your systems are actually affected and exposed.</p>
  {% set published = run.reports|selectattr("decision.baseline_label", "ne", "N/A")|list %}
  {% if differs %}
  <p style="margin:0 0 6px"><b>{{ differs|length }} of {{ published|length }}</b> vulnerabilities get a different answer:</p>
  <ul class="items">
  {% for r in differs %}
    {% set base = r.decision.baseline_label %}
    <li><span class="bshort"><a href="#{{ r.cve_id }}">{{ r.cve_id }}</a>{% set nm = display_name(r) %}{% if nm %} <span class="meta">— “{{ nm[0]|truncate(45) }}”</span>{% endif %}: score alone says <b>{{ PLAIN_LABEL.get(base, base) }}{% if base in ("P1","P2","P3","P4") %} ({{ base }}){% endif %}</b>, this tool says <b>{{ PLAIN_LABEL.get(r.decision.label, r.decision.label) }}{% if r.decision.label in ("P1","P2","P3","P4") %} ({{ r.decision.label }}){% endif %}</b></span>
      <details class="bmore"><summary>why</summary><div class="bdetail">Because: {{ compare_why(r) }}.</div></details></li>
  {% endfor %}
  </ul>
  {% else %}<p style="margin:0">Every vulnerability gets the same answer as sorting by score alone.</p>{% endif %}
  <p class="meta" style="margin:8px 0 0">A different answer is expected, not an error: it shows how much your situation changes the order. Neither list is automatically "right" (see docs/EVALUATION.md).</p>
</div>

<div class="controls">
  <input id="q" type="search" placeholder="Search by CVE number, software or system name…" aria-label="Search">
  <button id="expand" type="button">Open all cards</button>
  <button id="reset" type="button">Clear filters</button>
</div>

{% macro chips(cve, ids) %}{% if ids %}<span class="chips">{% for i in ids[:3] %}<a class="chip" href="#{{ cve }}-{{ i }}" title="Show evidence {{ i }}">{{ i }}</a>{% endfor %}{% if ids|length > 3 %}<details class="more-chips"><summary class="chip more" title="{{ ids[3:]|join(', ') }}">+{{ ids|length - 3 }} more</summary>{% for i in ids[3:] %}<a class="chip" href="#{{ cve }}-{{ i }}" title="Show evidence {{ i }}">{{ i }}</a>{% endfor %}</details>{% endif %}</span>{% endif %}{% endmacro %}
{% macro bullet(cve, text) %}{% set it = text|split_item %}<li><span class="bshort">{{ it[0] }}</span>{% if it[1] or it[2] %}<details class="bmore"><summary>details</summary><div class="bdetail">{{ it[1] }}{% if it[2] %} <span class="srcs">Sources: {{ chips(cve, it[2]) }}</span>{% endif %}</div></details>{% endif %}</li>{% endmacro %}
<section id="list" aria-label="CVE list">
{% if not run.reports %}<p class="empty">No vulnerabilities to show.{% if run.discovery %} Discovery searched {{ run.discovery.queries|selectattr("status", "eq", "ok")|list|length }} components and found no known CVEs. This is not proof there are none: see the discovery limits above.{% endif %}</p>{% endif %}
{% for r in run.reports %}
{% set d = r.decision %}
{% set st = status.get(d.label, ("muted", "–")) %}
{% set group = group_of(d.label) %}
<details class="cve" id="{{ r.cve_id }}" data-group="{{ group }}" data-text="{{ (r.cve_id ~ ' ' ~ (r.bundle.title or '') ~ ' ' ~ (r.applicability|map(attribute='asset_id')|join(' ')) ~ ' ' ~ (r.applicability|map(attribute='software.product')|join(' ')))|lower }}">
  <summary>
    <span class="cveid">{{ r.cve_id }}</span>
    <span><span class="badge s-{{ st[0] }}"><span aria-hidden="true">{{ st[1] }}</span>{{ BADGE.get(d.label, d.label) }}{% if d.provisional %} · provisional{% endif %}</span></span>
    <span class="headline">{{ PLAIN_LABEL.get(d.label, d.headline) }}</span>
    {% set nm = display_name(r) %}{% if nm %}<span class="vtitle">{{ nm[1] }}: “{{ nm[0]|truncate(110) }}”</span>{% endif %}
    {% if r.bundle.record_state == "published" %}<span class="factors">
      {% set fc = factor_cards(r) %}
      <span>attacks: <b>{{ fc[0][1] }}</b></span>
      <span>severity: <b>{{ fc[1][1] }}</b></span>
      <span>exposure: <b>{{ fc[2][1] }}</b></span>
      <span>ranked by score alone: <b>{{ d.baseline_label }}</b></span>
      {% if r.bundle.conflicts %}<span class="flag">⚠ {{ r.bundle.conflicts|length }} source conflict{{ "s" if r.bundle.conflicts|length > 1 }}</span>{% endif %}
      {% if "disputed" in r.bundle.findings %}<span class="flag">⚠ disputed</span>{% endif %}
      {% if r.bundle.sources|selectattr("status", "in", ["failed", "rate_limited"])|list %}<span class="flag">⚠ degraded sources</span>{% endif %}
    </span>{% endif %}
  </summary>
  <div class="body">
    <div class="summary-box s-{{ st[0] }}">
      <div class="sum-label"><span aria-hidden="true">{{ st[1] }}</span> {{ PLAIN_LABEL.get(d.label, d.label) }}{% if d.provisional %} <span class="prov">(provisional — depends on information not supplied)</span>{% endif %}</div>
      {% if r.summary %}{% for line in r.summary %}<p class="sum-why">{{ line }}</p>{% endfor %}
      {% else %}{% set why = why_sentence(d.factors) %}{% if why %}<p class="sum-why">{{ why }}</p>{% endif %}{% endif %}
      <h4>What to do</h4>
      <ul class="items">{% for a in d.actions %}{{ bullet(r.cve_id, a) }}{% endfor %}</ul>
    </div>

    {% if d.factors.exploitation != "n/a" %}
    <div class="fgrid">
      {% for name, value in factor_cards(r) %}<div class="fcard"><div class="fname">{{ name }}</div><div class="fval">{{ value }}</div></div>{% endfor %}
    </div>
    {% endif %}

    <section class="sec sec-why">
      <h3><span class="ico" aria-hidden="true">→</span>Why this priority</h3>
      <p class="hint">The rules that produced this decision, step by step.</p>
      <ol class="items">{% for t in d.trace %}{{ bullet(r.cve_id, t) }}{% endfor %}</ol>
    </section>

    <div class="cols">
      <section class="sec sec-known">
        <h3><span class="ico" aria-hidden="true">✓</span>What we know</h3>
        <p class="hint">Facts taken directly from the sources. Open “details” for the full explanation and where it came from.</p>
        <ul class="items">{% for k in r.known %}{{ bullet(r.cve_id, k) }}{% endfor %}</ul>
      </section>
      <section class="sec sec-unc">
        <h3><span class="ico" aria-hidden="true">?</span>What's uncertain</h3>
        <p class="hint">Gaps, conflicts between sources, and things a person should check.</p>
        <ul class="items">{% for u in r.uncertain %}{{ bullet(r.cve_id, u) }}{% else %}<li>Nothing flagged.</li>{% endfor %}</ul>
      </section>
    </div>

    <section class="sec sec-change">
      <h3><span class="ico" aria-hidden="true">↻</span>What would change this decision</h3>
      <p class="hint">New information that would move the priority up or down.</p>
      <ul class="items">{% for c in d.counterfactuals %}{{ bullet(r.cve_id, c) }}{% else %}<li>No single change identified.</li>{% endfor %}</ul>
    </section>

    {% if r.bundle.cvss %}
    {% set primary = r.bundle.primary_cvss %}
    <details class="desc-box">
      <summary><b>Severity score details</b> <span class="meta">({{ r.bundle.cvss|length }} score{{ "s" if r.bundle.cvss|length != 1 }} from {{ r.bundle.cvss|map(attribute="provider")|map("source_name")|unique|list|length }} source{{ "s" if r.bundle.cvss|map(attribute="provider")|unique|list|length != 1 }}; what the score is based on)</span></summary>
      <p class="hint" style="margin-top:8px">CVSS rates how serious a flaw is on paper (0–10). The rules use the highest score of the newest CVSS version{% if primary %} — here {{ primary.base_score }} from {{ primary.provider|source_name }}{% endif %}.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Source</th><th>CVSS version</th><th>Score</th><th>Rating</th><th>Technical code</th><th>Evidence</th></tr></thead>
        <tbody>
        {% for c in r.bundle.cvss %}
        <tr{% if primary and c.evidence_id == primary.evidence_id %} class="primary-row"{% endif %}><td>{{ c.provider|source_name }}{% if primary and c.evidence_id == primary.evidence_id %} <b>(used)</b>{% endif %}<br><span class="fcode">source ID: <code>{{ c.provider_id or c.provider }}</code>{% if c.provider_type %} · {{ c.provider_type }}{% endif %}</span></td><td>{{ c.version }}</td><td class="num">{{ c.base_score if c.base_score is not none else "–" }}</td><td>{{ (c.severity or "")|capitalize }}</td><td><code class="vec">{{ c.vector or "–" }}</code></td><td>{{ chips(r.cve_id, [c.evidence_id]) }}</td></tr>
        {% endfor %}
        </tbody></table></div>
      {% if primary and primary.vector %}
      <h4 style="margin:12px 0 4px">What the {{ primary.base_score }} score says, in plain words</h4>
      <ul class="items">{% for name, val in primary.vector|explain_vector %}<li><b>{{ name }}:</b> {{ val }}</li>{% endfor %}</ul>
      <p class="meta">Technical code: <code>{{ primary.vector }}</code></p>
      {% endif %}
    </details>
    {% endif %}
    <details class="desc-box tech">
      <summary><b>Technical details</b> <span class="meta">(for specialists: rule codes and raw values)</span></summary>
      <div class="table-wrap"><table>
        <tbody>
        <tr><th>Rule outcome</th><td><code>{{ d.label }}</code>{% if d.priority and d.priority != d.label %} (priority if affected: <code>{{ d.priority }}</code>){% endif %}{% if d.provisional %} · provisional{% endif %} — {{ d.headline.split(": ", 1)[1] if d.headline.startswith(d.label ~ ":") else d.headline }}</td></tr>
        <tr><th>Rule inputs</th><td>exploitation <code>{{ d.factors.exploitation }}</code> · severity <code>{{ d.factors.severity }}</code> · exposure <code>{{ d.factors.exposure }}</code></td></tr>
        <tr><th>Severity-only baseline</th><td><code>{{ d.baseline_label }}</code> (what ranking by CVSS score alone would give)</td></tr>
        <tr><th>Deterministic findings</th><td>{% for name, f in r.bundle.findings.items() %}<code>{{ name }}={{ f.value }}</code>{{ " · " if not loop.last }}{% endfor %}</td></tr>
        <tr><th>Record</th><td>state <code>{{ r.bundle.record_state }}</code>{% if r.bundle.cwes %} · weaknesses {{ r.bundle.cwes|join(", ") }}{% endif %}{% if r.bundle.epss %} · EPSS <code>{{ "%.4f"|format(r.bundle.epss.probability) }}</code> (percentile {{ "%.4f"|format(r.bundle.epss.percentile) }}){% endif %}</td></tr>
        <tr><th>How this CVE was selected</th><td>{% if r.discovered_by %}found by discovery: {{ r.discovered_by|join("; ") }}{% else %}supplied by the user (command line or watchlist){% endif %}</td></tr>
        <tr><th>Sources</th><td>{% for s in r.bundle.sources %}{{ s.source }}=<code>{{ s.status }}</code>{% if s.from_cache %} (cached){% endif %}{{ " · " if not loop.last }}{% endfor %}</td></tr>
        </tbody></table></div>
    </details>

    {% if r.bundle.description %}
    <details class="desc-box">
      <summary><b>Official description</b> <span class="meta">(from the CVE record — copied word for word; untrusted text)</span></summary>
      <p>{{ (r.bundle.title ~ " — ") if r.bundle.title }}{{ r.bundle.description|truncate(1500) }}</p>
    </details>
    {% endif %}

    <div class="ai">
      <div class="tag">AI-assisted assessment · judgement, not fact</div>
      {% if r.llm.scripted %}<div class="scripted">SCRIPTED EXAMPLE — hand-written by the project author for the offline demo. Not produced by a language model.</div>{% endif %}
      {% set a = r.llm.assessment %}
      {% if r.llm.status == "ok" and a %}
      <p class="meta">Provider <b>{{ r.llm.provider }}</b>, model <b>{{ r.llm.model }}</b>{% if r.llm.prompt_version %}, prompt version {{ r.llm.prompt_version }}{% endif %} · <b>{{ r.llm.supported_claims }} of {{ r.llm.total_claims }}</b> claims passed the checks (the cited evidence exists, the claim's quote appears in it word for word, and any version numbers or dates it mentions are in it). This shows the claim is grounded in its source, not that the reasoning is correct. Ratings are opinions, not probabilities.</p>
      <div class="cols">
        <div>
          <h3>How hard to build an attack: {{ AI_RATING.get(a.exploit_development_difficulty.rating, a.exploit_development_difficulty.rating) }}</h3>
          <ul class="tight">
          {% for title, claims in [("Prerequisite", a.exploit_development_difficulty.prerequisites), ("Complexity", a.exploit_development_difficulty.complexity_factors), ("Research", a.exploit_development_difficulty.research_availability)] %}
            {% for c in claims %}<li><span class="bshort">{{ c.statement }}</span><details class="bmore"><summary>details</summary><div class="bdetail">{% if c.quote %}Quoted from the source: “{{ c.quote }}”<br>{% endif %}{{ title }} · {{ "restates a source" if c.type == "fact" else "AI inference" }} <span class="srcs">Sources: {{ chips(r.cve_id, c.evidence_ids) }}</span></div></details></li>{% endfor %}
          {% endfor %}
          </ul>
        </div>
        <div>
          <h3>Existing attacks and attack code: {{ AI_RATING.get(a.existing_exploit_usability.rating, a.existing_exploit_usability.rating) }}</h3>
          <p class="meta">This rating comes from CISA's lists and exploit references, not from the AI. The points below are the AI's cited details.</p>
          <ul class="tight">
          {% for title, claims in [("Exploit evidence", a.existing_exploit_usability.exploit_evidence), ("Reliability limit", a.existing_exploit_usability.reliability_limitations), ("Required access", a.existing_exploit_usability.required_access)] %}
            {% for c in claims %}<li><span class="bshort">{{ c.statement }}</span><details class="bmore"><summary>details</summary><div class="bdetail">{% if c.quote %}Quoted from the source: “{{ c.quote }}”<br>{% endif %}{{ title }} · {{ "restates a source" if c.type == "fact" else "AI inference" }} <span class="srcs">Sources: {{ chips(r.cve_id, c.evidence_ids) }}</span></div></details></li>{% endfor %}
          {% endfor %}
          </ul>
        </div>
      </div>
      {% if a.summary %}<p class="meta"><i>{{ "Scripted summary" if r.llm.scripted else "Model summary" }} (uncited free text):</i> {{ a.summary }}</p>{% endif %}
      {% if r.llm.removed_claims or r.llm.rating_overrides %}
      <details class="desc-box">
        <summary><b>What the checker removed or corrected</b> <span class="meta">({{ (r.llm.removed_claims + r.llm.rating_overrides)|length }} item{{ "s" if (r.llm.removed_claims + r.llm.rating_overrides)|length != 1 }})</span></summary>
        <ul class="tight">{% for i in r.llm.removed_claims %}<li>Removed: “{{ i.statement|truncate(160) }}” — {{ "it cited nothing" if "no evidence" in i.problem else "it cited evidence that does not exist" }} <span class="meta">({{ i.path }})</span></li>{% endfor %}
        {% for i in r.llm.rating_overrides %}<li>Corrected a rating: {{ plain_override(i.problem) }} <span class="meta">({{ i.path }})</span></li>{% endfor %}</ul>
      </details>
      {% endif %}
      {% else %}
      <p class="meta"><b>{{ AI_STATUS.get(r.llm.status, r.llm.status) }}</b>{% if r.llm.detail %}: {{ ai_detail(r.llm.detail) }}{% endif %}</p>
      {% endif %}
    </div>

    {% if r.applicability %}
    <details class="desc-box">
      <summary><b>Which of your systems are affected</b> <span class="meta">({{ r.applicability|length }} checked; how each version was matched)</span></summary>
      <div class="table-wrap"><table>
        <thead><tr><th>System</th><th>Software</th><th>Result</th><th>Why</th></tr></thead>
        <tbody>
        {% for x in r.applicability %}
        <tr><td>{{ x.asset_id }}</td><td>{{ x.software.product }} {{ x.software.version }}</td><td class="st-{{ x.status }}">{{ APPLIES.get(x.status, x.status) }}{% if x.resolved_with_ai %}<br><span class="meta" title="Resolved by an AI reading of the vendor's wording; versions compared in code">AI-read wording</span>{% endif %}</td>
            <td><ul class="tight">{% for reason in x.reasons %}<li>{{ plain_reason(reason) }}</li>{% endfor %}</ul>
            <details class="more-raw"><summary class="meta">raw matching data</summary><ul class="tight meta">{% for reason in x.reasons %}<li>{{ reason }}</li>{% endfor %}</ul></details></td></tr>
        {% endfor %}
        </tbody></table></div>
      {% if r.version_reading %}{% set v = r.version_reading %}
      <p class="meta"><b>AI reading of the vendor's version wording</b> ({{ "scripted example" if v.scripted else v.provider ~ " / " ~ v.model }}; {{ v.status|replace("_", " ") }}{% if v.detail %}: {{ v.detail|truncate(140) }}{% endif %}). Versions are compared in code, and an AI reading alone never marks a system not affected.</p>
      <ul class="tight meta">
      {% for a in v.accepted %}<li>Read “{{ a.quote }}” as {{ a.ranges }} ({{ "may support “not affected” when a structured source agrees" if a.may_clear else "can only confirm “affected”" }})</li>{% endfor %}
      {% for x in v.rejected %}<li>Rejected: “{{ x.statement|truncate(100) }}”: {{ x.problem }}</li>{% endfor %}
      </ul>
      {% endif %}
    </details>
    {% endif %}

    <details>
      <summary><b>Evidence ({{ r.bundle.evidence|length }} item{{ "" if r.bundle.evidence|length == 1 else "s" }}) and source status</b></summary>
      <p class="meta">Sources: {% for s in r.bundle.sources %}{{ s.source }}=<b>{{ s.status }}</b>{% if s.detail %} ({{ s.detail|truncate(120) }}){% endif %}{{ "; " if not loop.last }}{% endfor %}</p>
      <div class="table-wrap"><table>
        <thead><tr><th>ID</th><th>Source</th><th>Summary</th><th>Retrieved</th><th>Published / updated</th></tr></thead>
        <tbody>
        {% for e in r.bundle.evidence %}
        <tr id="{{ r.cve_id }}-{{ e.id }}">
          <td class="num">{{ e.id }}</td>
          <td>{% if e.url|safe_url %}<a href="{{ e.url|safe_url }}" rel="noopener noreferrer nofollow">{{ e.source }}</a>{% else %}{{ e.source }}{% endif %}{% if e.demo %} <span class="meta">(demo)</span>{% endif %}</td>
          <td>{{ e.summary }}{% if e.fields.reference_url and e.fields.reference_url|safe_url %}<br><a href="{{ e.fields.reference_url|safe_url }}" rel="noopener noreferrer nofollow">{{ e.fields.reference_url|truncate(90) }}</a>{% endif %}{% if "possible_prompt_injection" in e.flags %}<br><span class="flag">⚠ contains instruction-like text (treated as data)</span>{% endif %}</td>
          <td class="num">{{ e.retrieved_at.strftime("%Y-%m-%d %H:%M") }}</td>
          <td class="num">{{ (e.published or "-")[:10] }} / {{ (e.updated or "-")[:10] }}</td>
        </tr>
        {% endfor %}
        </tbody></table></div>
    </details>
  </div>
</details>
{% endfor %}
</section>

<footer>
  <ul class="notices">{% for n in run.notices if not n.startswith(("OFFLINE DEMO", "Inventory and business context")) %}<li>{{ n }}</li>{% endfor %}</ul>
  <p>Priorities come from fixed, documented rules (docs/PRIORITIZATION.md), not from an AI. AI notes are checked against their cited evidence; they can affect a decision only by raising attack likelihood from "no sign of attacks" to "attacks likely", and, when auto-resolution is switched on, by reading a vendor's version wording (versions are compared in code, and an AI reading alone never marks a system not affected). Automated tests do not prove every security judgement is right: review before acting.</p>
</footer>
</main>
<script>
(function () {
  var q = document.getElementById("q"), items = document.querySelectorAll("details.cve"), tiles = document.querySelectorAll(".tile");
  var active = null;
  function apply() {
    var term = (q.value || "").toLowerCase().trim();
    items.forEach(function (el) {
      var ok = (!active || el.dataset.group === active) && (!term || el.dataset.text.indexOf(term) !== -1);
      el.classList.toggle("hidden", !ok);
    });
  }
  tiles.forEach(function (t) {
    t.addEventListener("click", function () {
      active = active === t.dataset.filter ? null : t.dataset.filter;
      tiles.forEach(function (x) { x.setAttribute("aria-pressed", String(x.dataset.filter === active)); });
      apply();
    });
  });
  q.addEventListener("input", apply);
  document.getElementById("reset").addEventListener("click", function () { active = null; q.value = ""; tiles.forEach(function (x) { x.setAttribute("aria-pressed", "false"); }); apply(); });
  function goTo(id) {
    var t = document.getElementById(id);
    if (!t) return;
    var card = t.closest("details.cve");
    if (card && card.classList.contains("hidden")) {  // hidden by a tile filter or search: clear them
      active = null; q.value = "";
      tiles.forEach(function (x) { x.setAttribute("aria-pressed", "false"); });
      apply();
    }
    if (t.tagName === "DETAILS") t.open = true;
    for (var p = t.parentElement; p; p = p.parentElement) { if (p.tagName === "DETAILS") p.open = true; }
    if (history.replaceState) history.replaceState(null, "", "#" + id);
    requestAnimationFrame(function () { requestAnimationFrame(function () { t.scrollIntoView({ block: "start" }); }); });
    var flash = card && t === card ? card : t;
    flash.classList.remove("flash"); void flash.offsetWidth; flash.classList.add("flash");
  }
  document.querySelectorAll('a.chip, .compare a[href^="#"]').forEach(function (c) {
    c.addEventListener("click", function (ev) { ev.preventDefault(); goTo(c.getAttribute("href").slice(1)); });
  });
  if (location.hash) { goTo(decodeURIComponent(location.hash.slice(1))); }
  var themeBtn = document.getElementById("theme"), modes = ["auto", "light", "dark"], mode = "auto";
  try { mode = localStorage.getItem("cveprio-theme") || "auto"; } catch (e) {}
  function setTheme(m) {
    mode = modes.indexOf(m) === -1 ? "auto" : m;
    if (mode === "auto") document.documentElement.removeAttribute("data-theme");
    else document.documentElement.setAttribute("data-theme", mode);
    themeBtn.textContent = "Theme: " + mode;
    themeBtn.setAttribute("aria-label", "Colour theme: " + (mode === "auto" ? "automatic" : mode) + ". Click to change.");
    try { localStorage.setItem("cveprio-theme", mode); } catch (e) {}
  }
  setTheme(mode);
  themeBtn.addEventListener("click", function () { setTheme(modes[(modes.indexOf(mode) + 1) % modes.length]); });
  document.getElementById("expand").addEventListener("click", function () { var open = this.textContent === "Open all cards"; items.forEach(function (el) { el.open = open; }); this.textContent = open ? "Close all cards" : "Open all cards"; });
})();
</script>
</body>
</html>
