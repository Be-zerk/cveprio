# Copy to .env (never commit .env). All values are optional.
# Environment variables already set in your shell take precedence over .env.

# --- Live data sources -------------------------------------------------------
# Free NVD API key (raises limit from 5 to 50 requests / 30 s):
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Model provider for the AI-assisted analysis ----------------------------
# Resolve "needs review" caused by vendors' free-text version wording (on/off). Common wordings are
# read by exact patterns in code; a model (if configured) handles the rest, and a model's reading
# alone never marks a system "not affected". Same as --auto-resolve.
CVEPRIO_AUTO_RESOLVE=off

# none | ollama | openai_compatible | anthropic
#   none              -> deterministic evidence + rules only (no model calls)
#   ollama            -> local Ollama via its native API (recommended for local models)
#   openai_compatible -> any /v1/chat/completions server (OpenAI, vLLM, LM Studio...)
#   anthropic         -> Claude via the official Anthropic SDK (pip install '.[anthropic]')
CVEPRIO_LLM_PROVIDER=none

# Model name for ollama / openai_compatible
CVEPRIO_LLM_MODEL=qwen2.5:3b

# ollama settings
CVEPRIO_OLLAMA_URL=http://localhost:11434
# Largest context window to request; prompts that would not fit are refused, never truncated.
CVEPRIO_LLM_NUM_CTX_MAX=16384
# Seconds to wait for one model answer (small local models on a CPU can need 10+ minutes)
CVEPRIO_LLM_TIMEOUT_S=600

# openai_compatible settings
CVEPRIO_LLM_BASE_URL=http://localhost:11434/v1
CVEPRIO_LLM_API_KEY=

# anthropic settings. This is a separate, pay-as-you-go API key from
# console.anthropic.com; a Claude / Claude Code subscription does NOT provide it.
ANTHROPIC_API_KEY=
CVEPRIO_ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (beta). Set to off if your account rejects it.
CVEPRIO_ANTHROPIC_FALLBACKS=on
